                "    Csv = Csv.Document(Binary.Decompress(Binary.FromText(Base64, BinaryEncoding.Base64), Compression.Deflate), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Csv, [PromoteAllScalars=true]),",
                "    Data = Table.TransformColumnTypes(Headers, {{\"Année\", Int64.Type}, {\"Numéro\", type text}, {\"Département\", type text}, {\"Code INSEE\", type text}, {\"Nom de la commune\", type text}, {\"Date de première alerte\", type date}, {\"Surface parcourue (m2)\", Int64.Type}, {\"Nature\", type text}, {\"Surface (ha)\", type number}}, \"en-US\")",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Nb_feux",
            "expression": [
              "COUNTROWS(Feux)"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Surface_brûlée(ha)",
            "expression": [
              "SUM(Feux[Surface (ha)])"
            ],
            "formatString": "#,0.0"
          },
          {
            "name": "Surface_moyenne(ha)",
            "expression": [
              "DIVIDE([Surface_brûlée(ha)], [Nb_feux])"
            ],
            "formatString": "#,0.0"
          },
          {
            "name": "Part causes humaines",
            "expression": [
              "DIVIDE(",
              "    CALCULATE(",
              "        [Nb_feux],",
              "        Feux[Nature] IN {",
              "            \"Malveillance\",",
              "            \"Involontaire (particulier)\",",
              "            \"Involontaire (travaux)\"",
              "        }",
              "    ),",
              "    [Nb_feux]",
              ")"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Surface moy. (ha)",
            "expression": [
              "VAR Annee = SELECTEDVALUE(Calendrier[Année])",
              "RETURN IF(NOT ISBLANK(Annee),",
              "    AVERAGEX(",
              "        FILTER(ALL(Calendrier[Année]), Calendrier[Année] >= Annee - 10 && Calendrier[Année] < Annee),",
              "        VAR AnneeReference = Calendrier[Année]",
              "        RETURN CALCULATE([Surface_brûlée(ha)], REMOVEFILTERS(Calendrier), Calendrier[Année] = AnneeReference)",
              "    )",
              ")"
            ],
            "formatString": "#,0.0"
          },
          {
            "name": "Surface N-1 (ha)",
            "expression": [
              "CALCULATE(",
              "    [Surface_brûlée(ha)],",
              "    SAMEPERIODLASTYEAR(Calendrier[Date])",
              ")"
            ],
            "formatString": "#,0.0"
          },
          {
            "name": "Écart vs moyenne",
            "expression": [
              "DIVIDE(",
              "    [Surface_brûlée(ha)] - [Surface moy. (ha)],",
              "    [Surface moy. (ha)]",
              ")"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Nombre de feux ≥ 1 ha",
            "expression": [
              "CALCULATE(",
              "    [Nb_feux],",
              "    Feux[Surface (ha)] >= 1",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Couleur écart",
            "expression": [
              "IF(",
              "    [Écart vs moyenne] > 0.1,",
              "    \"#E8590C\",",
              "    \"#9AA0A6\"",
              ")"
            ]
          },
          {
            "name": "Titre",
            "expression": [
              "\"Top 5 des communes · \" & SELECTEDVALUE(Departements[Nom du département], \"tous départements\") & \" · \" & FORMAT([Surface_brûlée(ha)], \"0.0\") & \" ha\""
            ]
          }
        ]
      }
    ],
