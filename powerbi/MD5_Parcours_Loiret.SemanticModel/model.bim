        "measures": [
          {
            "name": "Part causes inconnues",
            "expression": [
              "DIVIDE(",
              "    CALCULATE(",
              "        [Nb_feux],",
              "        Feux[Nature] = \"Inconnue\"",
              "    ),",
              "    [Nb_feux]",
              ")"
            ],
            "formatString": "0.0%"
          }
        ],
        "dataCategory": "Time"
